//ACTUAL_SAMPLE_RATE	=	125000000;
//ACTUAL_FREQUENCY		=	125000;
SAMPLE_RATE		=	125000000;	//MAX = 125000000, MIN = 488281, and should be (125000000 / n)
SAMPLE_POINTS	=	1000;		//MAX = 4194304
VOLTAGE_OFFSET	=	00;			//-512 ~ 511
ADDRESS_RADIX	=	UNS;		// 地址格式：UNS(无符号)/HEX/BIN/DEC
DATA_RADIX		=	DEC;		// 数据格式：BIN/HEX/DEC

DATA
BEGIN
[0..249]	: 0;
[250..499]	: 511;
[500..749]	: 0;
[750..999]	: -512;
END